generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Opportunity {
  id                 Int      @id @default(autoincrement())
  title              String   @db.VarChar(255)
  client             String?  @db.VarChar(255)
  stage              String   @default("TOR Collection") @db.VarChar(50)
  deadline           String?  @db.VarChar(20)
  proposalType       String?  @db.VarChar(100)
  serviceCategory    String?  @db.VarChar(100)
  strategicFit       String?  @db.VarChar(20)
  bidDecision        String?  @db.VarChar(20)
  sector             String?  @db.VarChar(100)
  collectedBy        String?  @db.VarChar(100)
  country            String?  @db.VarChar(100)
  notes              String?
  documentUrl        String?
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  aiSummary          String?
  asanaTaskId        String?  @db.VarChar(100)
  asanaTaskUrl       String?  @db.VarChar(255)
  docsCompiled       Boolean  @default(false)
  experienceIds      Json?
  experienceSelected Boolean  @default(false)
  expertIdentified   Boolean  @default(false)
  expertIds          Json?
  financialPrepared  Boolean  @default(false)
  submitted          Boolean  @default(false)
  techDrafted        Boolean  @default(false)
  competitiveScore   Int?     @default(50)
  knownCompetitors   String?
  strengths          Json?
  weaknesses         Json?
  whyBid             String?
  whyNotBid          String?
  winProbability     Int?     @default(50)

  @@map("opportunities")
}

model Expert {
  id               Int      @id @default(autoincrement())
  name             String   @db.VarChar(255)
  title            String?  @db.VarChar(255)
  expertType       String?  @db.VarChar(100)
  specialization   String?  @db.VarChar(100)
  country          String?  @db.VarChar(100)
  email            String?  @db.VarChar(255)
  phone            String?  @db.VarChar(50)
  yearsExp         String?  @db.VarChar(20)
  notes            String?
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  documents        Json?
  priorExperience  String?  @db.VarChar(20)
  researchInterest String?
  summary          String?

  @@map("experts")
}

model Experience {
  id          Int      @id @default(autoincrement())
  title       String   @db.VarChar(255)
  client      String?  @db.VarChar(255)
  country     String?  @db.VarChar(100)
  sector      String?  @db.VarChar(100)
  services    String?  @db.VarChar(100)
  startDate   String?  @db.VarChar(50)
  endDate     String?  @db.VarChar(50)
  value       String?  @db.VarChar(100)
  teamSize    String?  @db.VarChar(50)
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  documents   Json?

  @@map("experiences")
}

model Partner {
  id               Int      @id @default(autoincrement())
  name             String   @db.VarChar(255)
  type             String?  @db.VarChar(100)
  country          String?  @db.VarChar(100)
  email            String?  @db.VarChar(255)
  contactPerson    String?  @db.VarChar(255)
  phone            String?  @db.VarChar(50)
  sector           String?  @db.VarChar(100)
  status           String?  @default("Contacted") @db.VarChar(50)
  notes            String?
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  engagementReason String?  @db.VarChar(100)
  expertise        String?  @db.VarChar(255)
  opportunityId    Int?

  @@map("partners")
}

model PartnerRequest {
  id          Int      @id @default(autoincrement())
  firmName    String   @db.VarChar(255)
  country     String?  @db.VarChar(100)
  description String?
  decision    String?  @default("Under Review") @db.VarChar(50)
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("partner_requests")
}
